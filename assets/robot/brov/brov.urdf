<?xml version="1.0"?>
<robot name="brov">
  <!-- World link (fixed reference) -->
  <link name="world"/>

  <!-- X translation joint -->
  <joint name="x_joint" type="prismatic">
    <parent link="world"/>
    <child link="x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10.0"/>
  </joint>
  <link name="x_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Y translation joint -->
  <joint name="y_joint" type="prismatic">
    <parent link="x_link"/>
    <child link="y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10.0"/>
  </joint>
  <link name="y_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Z translation joint -->
  <joint name="z_joint" type="prismatic">
    <parent link="y_link"/>
    <child link="z_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-100" upper="100" effort="1000" velocity="10.0"/>
  </joint>
  <link name="z_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Yaw rotation joint (around Z) - limited to ±180 degrees -->
  <joint name="yaw_joint" type="revolute">
    <parent link="z_link"/>
    <child link="yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>
  <link name="yaw_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Pitch rotation joint (around Y) - limited to ±90 degrees -->
  <joint name="pitch_joint" type="revolute">
    <parent link="yaw_link"/>
    <child link="pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="100" velocity="2.0"/>
  </joint>
  <link name="pitch_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Roll rotation joint (around X) - limited to ±180 degrees -->
  <joint name="roll_joint" type="revolute">
    <parent link="pitch_link"/>
    <child link="roll_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="2.0"/>
  </joint>
  <link name="roll_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Fixed joint to the AUV body -->
  <joint name="body_joint" type="fixed">
    <parent link="roll_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- AUV Body (the visible part) -->
  <link name="base_link">
    <visual>
      <!-- Offset to align mesh with collision spheres (mesh origin is above center) -->
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry>
        <mesh filename="BROV_high.usd" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.25"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.5" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
  </link>

  <!-- End effector link (for motion planning target) - at center of AUV -->
  <joint name="ee_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red">
        <color rgba="1.0 0.0 0.0 0.5"/>
      </material>
    </visual>
  </link>

  <!-- ============================================== -->
  <!-- Camera Pan-Tilt Mount System                   -->
  <!-- ============================================== -->

  <!-- Camera mount base - fixed to front of AUV body -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
    <!-- Position at front of AUV (positive X is forward) -->
    <origin xyz="0.20 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Camera yaw joint (pan left/right) - ±70 degrees (~1.22 rad) -->
  <joint name="camera_yaw_joint" type="revolute">
    <parent link="camera_mount_link"/>
    <child link="camera_yaw_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22173" upper="1.22173" effort="10" velocity="1.0"/>
  </joint>
  <link name="camera_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.03"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Camera pitch joint (tilt up/down) - ±70 degrees (~1.22 rad) -->
  <joint name="camera_pitch_joint" type="revolute">
    <parent link="camera_yaw_link"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.22173" upper="1.22173" effort="10" velocity="1.0"/>
  </joint>
  
  <!-- Camera link - the actual camera (NEW END EFFECTOR) -->
  <link name="camera_link">
    <visual>
      <!-- Camera body -->
      <origin xyz="0.025 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <visual>
      <!-- Camera lens -->
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.015"/>
      </geometry>
      <material name="lens_blue">
        <color rgba="0.2 0.2 0.4 1.0"/>
      </material>
    </visual>
    <!-- Camera frustum visualization (4 edges of pyramid) -->
    <!-- Lens at x=0.06, far plane at x=0.35 with corners at y=±0.16, z=±0.12 -->
    <!-- Edge length ~0.35m, cylinders centered at midpoint between lens and corner -->
    <visual>
      <!-- Top-left edge: from (0.06,0,0) to (0.35, 0.16, 0.12) -->
      <origin xyz="0.205 0.08 0.06" rpy="0.33 1.57 0.49"/>
      <geometry>
        <cylinder radius="0.003" length="0.35"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Top-right edge: from (0.06,0,0) to (0.35, -0.16, 0.12) -->
      <origin xyz="0.205 -0.08 0.06" rpy="-0.33 1.57 -0.49"/>
      <geometry>
        <cylinder radius="0.003" length="0.35"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Bottom-left edge: from (0.06,0,0) to (0.35, 0.16, -0.12) -->
      <origin xyz="0.205 0.08 -0.06" rpy="-0.33 1.57 0.49"/>
      <geometry>
        <cylinder radius="0.003" length="0.35"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Bottom-right edge: from (0.06,0,0) to (0.35, -0.16, -0.12) -->
      <origin xyz="0.205 -0.08 -0.06" rpy="0.33 1.57 -0.49"/>
      <geometry>
        <cylinder radius="0.003" length="0.35"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <!-- Frustum far plane (rectangle outline) -->
    <visual>
      <!-- Top edge -->
      <origin xyz="0.35 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.32 0.006"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Bottom edge -->
      <origin xyz="0.35 0 -0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.32 0.006"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Left edge -->
      <origin xyz="0.35 0.16 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.006 0.24"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <visual>
      <!-- Right edge -->
      <origin xyz="0.35 -0.16 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.006 0.006 0.24"/>
      </geometry>
      <material name="frustum_yellow">
        <color rgba="1.0 1.0 0.0 0.7"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Camera optical frame - for motion planning target (looking along +X) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <!-- At the front of the lens, looking forward (+X) -->
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
      </material>
    </visual>
  </link>
</robot>
